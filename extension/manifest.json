{
  "manifest_version": 3,
  "name": "Hermes Chrome Pilot",
  "version": "2.0",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "debugger",
    "notifications",
    "windows"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Hermes Chrome Pilot",
    "default_icon": { "16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png" }
  },
  "background": { "service_worker": "background.js" }
}
